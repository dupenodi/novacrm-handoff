# Connects Gmail, Rocketlane and Slack
COMPOSIO_API_KEY=
# Composio user that owns the connected Gmail, Rocketlane and Slack accounts.
COMPOSIO_USER_ID=novacrm-cs

# Voice calls to account executives — Sarvam Voice Agents (https://indus.sarvam.ai)
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
# Plan-confirm agent id and published version
SARVAM_APP_ID=
SARVAM_APP_VERSION=3
# Connection that owns the rented number, and the number in E.164
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=+917965850505
# Sarvam posts each call's result to PUBLIC_APP_URL/api/webhooks/sarvam?secret=<this>. Any random string.
SARVAM_WEBHOOK_SECRET=
# Demos: every AE call rings this number (your phone) instead of the number in the email
DEMO_AE_PHONE=

# Runs the agents and reads deal emails
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Slack: real (default) posts through Composio and falls back to a simulated channel when Slack isn't connected.
# mock = always simulated.
SLACK_MODE=real

# Public origin Composio (Gmail trigger) and Sarvam (call results) post to, e.g. https://novacrm.example.com. Locally, an ngrok URL.
# Voice calls need it; without it Gmail is only checked while the app is open.
PUBLIC_APP_URL=

# Shared Postgres (local + hosted). Server-only — never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: your Rocketlane workspace (e.g. https://acme.rocketlane.com) so the app can link to created projects
ROCKETLANE_APP_URL=
