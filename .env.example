# Connects Gmail, Rocketlane and Slack
COMPOSIO_API_KEY=

# Voice calls to account executives — Sarvam Voice Agents (https://indus.sarvam.ai)
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
# Tier-confirm agent id and published version
SARVAM_APP_ID=
SARVAM_APP_VERSION=3
# Connection that owns the rented number, and the number in E.164
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=+917965850505
# Optional default destination for demos (your phone — all personas use this)
SARVAM_TEST_AE_NUMBER=
DEMO_AE_PHONE=

# Reads deal emails and drives Vercel AI SDK agent tool loops
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Slack: real (default) uses Composio when connected, falls back to mock if not.
# mock = always mock. real_strict = Composio only (errors if disconnected).
SLACK_MODE=real

# Public origin for Gmail trigger webhooks (e.g. https://novacrm.example.com)
PUBLIC_APP_URL=

# Shared Postgres (local + hosted). Server-only — never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
