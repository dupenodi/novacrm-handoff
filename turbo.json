{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["COMPOSIO_*", "SARVAM_*", "OPENROUTER_*", "ROCKETLANE_*", "SLACK_*", "SUPABASE_*", "PUBLIC_APP_URL", "DEMO_AE_PHONE"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {},
    "test": {}
  }
}
